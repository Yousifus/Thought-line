# Copy to .env and fill in. Never commit .env.

# Required: bearer token for every /api and /mcp request (24+ characters).
TL_TOKEN=replace-with-a-long-random-string
# Listen address. Never 0.0.0.0 or ::. Use 127.0.0.1 or your Tailscale address.
TL_HOST=127.0.0.1
TL_PORT=4390
TL_DATA_DIR=./data
TL_MAX_CHARS=24000

# Local model (OpenAI-compatible endpoint). Private pieces only ever go here.
TL_LOCAL_BASE_URL=http://127.0.0.1:1234/v1
TL_LOCAL_MODEL=your-local-model-id
# The local endpoint must be loopback, LAN, Tailscale (100.64.0.0/10) or *.local.
# To use any other host (a Tailscale MagicDNS name such as box.tailnet.ts.net, say), set it here exactly
# (hostname only). Private writing is sent there.
TL_LOCAL_ALLOW_HOST=

# Optional cloud model. Set all three or none.
TL_CLOUD_BASE_URL=
TL_CLOUD_MODEL=
TL_CLOUD_API_KEY=

# Dev only: serve a canned analysis instead of calling a model.
TL_FIXTURE_ANALYSIS=

# Eval script only: comma-separated model ids on TL_LOCAL_BASE_URL.
TL_EVAL_MODELS=
